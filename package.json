{
  "name": "big-oh-no",
  "version": "0.1.0",
  "description": "Catch O(n\u00b2) regressions in your tests. Assert time complexity in Vitest, Jest or node:test by measuring growth, not milliseconds.",
  "keywords": [
    "big-o",
    "complexity",
    "time-complexity",
    "performance",
    "regression",
    "vitest",
    "jest",
    "testing",
    "benchmark",
    "quadratic",
    "redos",
    "algorithm"
  ],
  "author": "Deepanjal (https://github.com/Deepanjal-s)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Deepanjal-s/big-oh-no.git"
  },
  "homepage": "https://github.com/Deepanjal-s/big-oh-no#readme",
  "bugs": "https://github.com/Deepanjal-s/big-oh-no/issues",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./vitest": {
      "import": {
        "types": "./dist/vitest.d.ts",
        "default": "./dist/vitest.js"
      },
      "require": {
        "types": "./dist/vitest.d.cts",
        "default": "./dist/vitest.cjs"
      }
    },
    "./jest": {
      "import": {
        "types": "./dist/jest.d.ts",
        "default": "./dist/jest.js"
      },
      "require": {
        "types": "./dist/jest.d.cts",
        "default": "./dist/jest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/vitest.*",
    "./dist/jest.*"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:jest": "jest --config jest.config.cjs",
    "prepare": "tsup",
    "test:runtime": "node --expose-gc --test test/runtime.test.mjs"
  },
  "peerDependencies": {
    "vitest": ">=1",
    "jest": ">=27"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "jest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
